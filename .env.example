# Remote libsql:// URL is mandatory on Vercel. Local file only for local development/tests.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicnciLCJpYXQiOjE3OTI5NTYyMTUsImlkIjoiMDFhMTc0NTItY2IwMS03YTkwLWE0YTItNjIwZWE4YjVhY2ZjIiwia2lkIjoiZlk1UUMyV202VERnbTVqSFgwSEJFSXE4Z0ticDFBbXVEOVBCS2VSUl92byIsInJpZCI6ImYxZjZjNjA1LTAwZTAtNDBkYi1hMWJlLTlhOTc5MTBkZDkxMCJ9.vku2hGv_fKRBwzuCTSoIWyUIPHnwLNGEnz5b6SWMqWT7yAII6VtSuLDJ21hmM7if2F6ZmphtbcAadOz6u3l-BA
APP_ORIGIN=https://your-app.vercel.app
# Generate independently; never share with the browser. Used for hashing rate-limit identifiers.
AUTH_SECRET=replace_with_64_random_hex_characters
CRON_SECRET=replace_with_another_long_random_secret
# Only for local development: TURSO_DATABASE_URL=file:./development.db
# Optional: exact Expo web app origin if it calls this backend from another origin.
# Native Android/iOS requests do not need CORS.
NATIVE_WEB_ORIGIN=https://your-native-web-preview.example

# Required: Google OAuth WEB client, server only. No password accounts exist.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact one allowed Google email. Empty = deny all sign-ins.
OWNER_GOOGLE_EMAIL=
# 32 random bytes, base64 encoded. Used only on the server for Drive tokens.
GOOGLE_TOKEN_ENCRYPTION_KEY=
